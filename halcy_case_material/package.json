{
  "name": "halcy-agentic-checkout-pack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "hotel": "node mock-hotel/server.mjs",
    "hotel2": "node mock-hotel-2/server.mjs",
    "chat": "tsx starter/chat/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"starter/**/*.test.ts\"",
    "audit:runs": "tsx starter/agent/evidence/audit-cli.ts",
    "scenarios": "tsx starter/agent/scenarios/run.ts",
    "setup": "playwright install chromium",
    "agent:check": "tsx starter/agent/check.ts",
    "chat:booking": "AGENT=booking tsx starter/chat/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "playwright": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
